BOT_TOKEN=xxxx:YYYY...
SPREADSHEET_ID=1AbCdeFGhIJk...
# Список Telegram ID через запятую
ALLOWED_USERS=123456789,987654321
GOOGLE_CREDENTIALS_B64=egIC0e

# development/production; в production бот завершается при ошибке конфига
NODE_ENV=development

# Порт health-check сервера; Render задаёт PORT автоматически
PORT=3000

# Подробные debug-логи: 1/true/yes/on — включить, 0/false/no/off — выключить
DEBUG=false

# Cloudflare Workers AI (опционально, для распознавания свободного текста)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_PARSING_ENABLED=true
